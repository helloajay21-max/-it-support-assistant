# ===============================
# Fill these values before running
# Copy this file to .env
# NEVER commit .env to GitHub
# ===============================

# App runtime (local and Azure)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
SQLITE_DB_PATH=data/tickets.db
WEBSITES_PORT=8501
ADMIN_EMAIL=helloajay21@gmail.com

# Docker Hub (image registry)
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=your-dockerhub-token
IMAGE_NAME=it-support-assistant

# Azure resources
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=eastus
RESOURCE_GROUP=your-resource-group
APP_SERVICE_PLAN=your-app-service-plan
WEBAPP_NAME=your-webapp-name

# Logging
LOG_LEVEL=INFO
ENABLE_FILE_LOG=false

# SMTP (required for actual VPN email delivery)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=helloajay21@gmail.com
SMTP_USE_TLS=true
ADMIN_EMAIL=helloajay21@gmail.com

# Optional: base URL used inside VPN reset emails
VPN_RESET_BASE_URL=https://selfservice.techcorp.com/reset-vpn
